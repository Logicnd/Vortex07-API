{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/v1/likes/:targetId",
      "destination": "/api/v1/likes/:targetId"
    },
    {
      "source": "/v1/ratings/:targetId",
      "destination": "/api/v1/ratings/:targetId"
    },
    {
      "source": "/v1/comments/:gameId/:commentId",
      "destination": "/api/v1/comments?gameId=:gameId&commentId=:commentId"
    },
    {
      "source": "/v1/comments/:gameId",
      "destination": "/api/v1/comments?gameId=:gameId"
    },
    {
      "source": "/v1/forum/categories",
      "destination": "/api/v1/forum/categories"
    },
    {
      "source": "/v1/forum/rename-author",
      "destination": "/api/v1/forum/rename-author"
    },
    {
      "source": "/v1/forum/repair",
      "destination": "/api/v1/forum/repair?action=repair"
    },
    {
      "source": "/v1/forum/reseed",
      "destination": "/api/v1/forum/repair?action=reseed"
    },
    {
      "source": "/v1/forum/rebuild-index",
      "destination": "/api/v1/forum/repair?action=rebuild-index"
    },
    {
      "source": "/v1/forum/diagnose",
      "destination": "/api/v1/forum/repair?action=diagnose"
    },
    {
      "source": "/v1/forum/purge-spoof",
      "destination": "/api/v1/forum/repair?action=repair-names"
    },
    {
      "source": "/v1/forum/repair-names",
      "destination": "/api/v1/forum/repair?action=repair-names"
    },
    {
      "source": "/v1/forum/threads",
      "destination": "/api/v1/forum/threads"
    },
    {
      "source": "/v1/forum/threads/:threadId",
      "destination": "/api/v1/forum/threads/:threadId"
    },
    {
      "source": "/v1/forum/threads/:threadId/posts",
      "destination": "/api/v1/forum/threads/:threadId/posts"
    },
    {
      "source": "/v1/forum/threads/:threadId/posts/:postId",
      "destination": "/api/v1/forum/threads/:threadId/posts/:postId"
    },
    {
      "source": "/v1/dm/inbox",
      "destination": "/api/v1/dm/inbox"
    },
    {
      "source": "/v1/dm/unread",
      "destination": "/api/v1/dm/unread"
    },
    {
      "source": "/v1/dm/threads/:peerId/messages",
      "destination": "/api/v1/dm/send?peerId=:peerId"
    },
    {
      "source": "/v1/dm/threads/:peerId",
      "destination": "/api/v1/dm/thread?peerId=:peerId"
    },
    {
      "source": "/v1/dm/mod/logs",
      "destination": "/api/v1/dm/mod-logs"
    },
    {
      "source": "/v1/dm/mod/muted",
      "destination": "/api/v1/dm/mod-muted"
    },
    {
      "source": "/v1/dm/mod/mute",
      "destination": "/api/v1/dm/mod-mute"
    },
    {
      "source": "/v1/dm/mod/unmute",
      "destination": "/api/v1/dm/mod-unmute"
    }
  ]
}
